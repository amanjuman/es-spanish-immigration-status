# Copy this file to .env and fill in your values.
# Everything has a sensible default except Telegram (optional but recommended
# for monitoring — without it you only get on-demand checks in the browser).

# ── Telegram notifications (optional) ─────────────────────────────
# Create a bot with @BotFather and paste its token here. Subscribing to
# alerts then happens through the web UI: each monitor gets a one-time
# t.me activation link / QR that binds the subscriber's Telegram chat.
TELEGRAM_TOKEN=
# Optional fallback: this chat id additionally receives ALL monitor alerts
# (useful for the instance owner). Get yours from @userinfobot.
TELEGRAM_CHAT_ID=

# ── Captcha solving ───────────────────────────────────────────────
# ocr        — built-in Tesseract OCR, free, succeeds ~55-60% per run
#              (background monitors just retry next cycle; on-demand
#              checks may need a manual retry)
# 2captcha   — 2captcha.com paid API, near-100% success
# anticaptcha — anti-captcha.com paid API, near-100% success
CAPTCHA_PROVIDER=ocr
CAPTCHA_API_KEY=
# If a paid provider errors (e.g. empty balance), fall back to free OCR
# for that attempt instead of failing the check.
CAPTCHA_OCR_FALLBACK=true

# ── Checking behaviour ────────────────────────────────────────────
# Minimum seconds between two visits to the government site. The site
# sits behind an aggressive F5 WAF; lowering this risks getting your
# IP challenged or blocked. Leave the default unless you know better.
CHECK_SPACING_SECONDS=60
# How often each monitored expediente is re-checked (seconds).
MONITOR_INTERVAL_SECONDS=3600
# Max captcha attempts per check run.
CAPTCHA_MAX_ATTEMPTS=5

# ── Public-instance mode ──────────────────────────────────────────
# Turn on when this instance is reachable by strangers (VPS, public URL).
# Effects: monitors are visible/manageable ONLY through their secret
# /m/<token> links, the global list requires ADMIN_TOKEN, per-IP rate
# limits and the monitor cap apply, and TELEGRAM_CHAT_ID no longer
# receives other people's alerts.
PUBLIC_MODE=false
# Required in public mode for the operator's own /api/monitors access,
# the /admin dashboard, and the invitation controls.
ADMIN_TOKEN=
# Initial state of invite-only mode (require a one-time code to create a
# monitor). After first run, toggle it live from the /admin dashboard.
INVITE_ONLY=false
# External URL of this instance (used in bot messages for manage links),
# e.g. https://status.example.com
SITE_URL=
# Max monitors (0 = unlimited). The queue fits ~60 site visits/hour, so
# keep this around 40 on a public instance.
MAX_MONITORS=40
# Per-IP limits (public mode only).
RATE_LIMIT_CHECKS_PER_HOUR=6
RATE_LIMIT_MONITORS_PER_DAY=5
# Set true ONLY behind a reverse proxy you control (uses X-Forwarded-For).
TRUST_PROXY=false
# Optional Cloudflare Turnstile bot protection for the public forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Source networks that skip Turnstile (trusted LAN / VPN). Comma-separated
# CIDRs. Turnstile's dashboard only accepts hostnames, so IP-range
# exemptions are enforced by the app. Default covers loopback, RFC1918
# LAN (192.168/16) and the CGNAT range Tailscale uses (100.64/10).
TURNSTILE_EXEMPT_CIDRS=127.0.0.0/8,192.168.0.0/16,100.64.0.0/10
# Auto-cleanup (public mode): purge monitors N days after resolution /
# N days after creation if nobody ever subscribed.
PURGE_RESOLVED_AFTER_DAYS=30
PURGE_UNCLAIMED_AFTER_DAYS=7

# ── Server ────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# Where the SQLite DB, logs and debug screenshots live.
DATA_DIR=./data
# Save debug screenshots of each check step (useful when something breaks).
DEBUG_SCREENSHOTS=false
